# ══════════════════════════════════════════════════════════════════
# .gitignore INDUK — berlaku untuk seluruh proyek.
# Berkas .gitignore di subfolder tetap berlaku dan menambah aturan ini.
# ══════════════════════════════════════════════════════════════════

# ── Rahasia — JANGAN PERNAH masuk repo ────────────────────────────
.env
.env.*
!.env.example
**/connector/config.json
!**/connector/config.example.json
**/js/config.local.js
!**/js/config.local.example.js

# Kredensial akun admin pertama yang ditulis engine saat boot pertama.
LOGIN_ADMIN_PERTAMA.txt
.auth-secret

# ── Setelan lokal per-mesin ───────────────────────────────────────
.claude/settings.local.json
.claude/launch.json

# ── Dependensi & artefak build (bisa dibangun ulang) ──────────────
node_modules/
dist/
dist-electron/
release/

# ── Data hidup — bukan artefak, jangan pernah dihapus manual ──────
# Basis data operasional PGlite. Isinya data klinik yang sesungguhnya.
pglite-data/
.pglite-dev/

# ── Cadangan & karantina ──────────────────────────────────────────
*.tar.gz
*.zip
_karantina_*/

# ── Knowledge graph (dibangkitkan ulang: graphify update .) ───────
graphify-out/

# ── Log & berkas sementara ────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# Kunci privat penerbit lisensi. Siapa pun yang memegangnya bisa menerbitkan
# lisensi OneLab yang sah untuk siapa saja — nilainya setara seluruh
# pendapatan lisensi produk ini. Simpan cadangannya di luar komputer kerja;
# kalau hilang, seluruh lisensi yang sudah terbit tidak bisa diperbarui.
.lisensi-privat.pem
*.privat.pem
