# ===============================================================
# ONELAB PLATFORM & AVA HEALTH — CONTOH KONFIGURASI
# Salin berkas ini menjadi `.env` lalu isi nilai aslinya.
# `.env` TIDAK boleh masuk repo (sudah diblok .gitignore).
# ===============================================================

# 1. Kunci LLM (rotasi multi-key & auto-failover)
#    GEMINI_API_KEYS dipisah koma; dipakai aiGateway.js untuk failover.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 2. Sumber data — tentukan ke mana aplikasi menyimpan data.
#    local    = PGlite di komputer ini (mode desktop/offline)
#    supabase = Supabase cloud
#    postgres = Postgres milik klien (bundle siap-instal)
ONELAB_DATA_MODE=local

# 3. Supabase (dipakai bila ONELAB_DATA_MODE=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 3b. Edge Function queue-public (atur sebagai Supabase secrets, bukan Vercel).
# Device harus terdaftar di tabel queue_public_devices setelah migrasi 0048.
QUEUE_PUBLIC_DEVICE_ID=kiosk.avahealth.sbs
QUEUE_PUBLIC_ALLOWED_ORIGINS=https://kiosk.avahealth.sbs,https://antrian.avahealth.sbs

# 4. Postgres milik klien (dipakai bila ONELAB_DATA_MODE=postgres)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# 5. SATUSEHAT (Kemenkes RI)
#    Client secret HANYA boleh ada di sisi server — jangan pernah menaruhnya
#    di berkas yang ikut ke peramban. Ambil kredensial di SATUSEHAT Platform.
#    SATUSEHAT_ENV: stg (uji coba) atau prod. Mulailah dari stg.
SATUSEHAT_ENV=stg
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=
#    Kosongkan dua baris ini untuk memakai alamat bawaan sesuai SATUSEHAT_ENV.
#    Isi hanya bila portal Anda memberi alamat berbeda.
SATUSEHAT_AUTH_URL=
SATUSEHAT_FHIR_URL=

# 6. Kuota & rate limit AI Gateway
AIGATEWAY_LIMIT_RPM=15
AIGATEWAY_LIMIT_TPM=1000000
AIGATEWAY_LIMIT_RPD=10000
AIGATEWAY_AUTO_FAILOVER=true
AIGATEWAY_REFILL_WINDOW_MIN=60
